# Flask 应用配置
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# 数据库配置
SQLALCHEMY_DATABASE_URI=mysql+pymysql://your_username:your_password@your_host:your_port/your_database
SQLALCHEMY_TRACK_MODIFICATIONS=False

# 存储配置
STORAGE_TYPE=local  # local, s3, ftp
LOCAL_STORAGE_PATH=/path/to/local/storage
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=your-s3-bucket
S3_REGION=your-s3-region
FTP_HOST=your-ftp-host
FTP_PORT=21
FTP_USERNAME=your-ftp-username
FTP_PASSWORD=your-ftp-password

# EasySync Agent 配置
EASYSYNC_AGENT_VERSION=1.0.0
EASYSYNC_AGENT_INSTALL_PATH=/opt/easysync/
EASYSYNC_AGENT_CONFIG_PATH=/opt/easysync/agent/config.yaml
EASYSYNC_AGENT_LOG_PATH=/var/log/easysync/agent.log
EASYSYNC_AGENT_BACKUP_PATH=/opt/easysync/backups

# EasySync Proxy 配置
EASYSYNC_PROXY_VERSION=1.0.0
EASYSYNC_PROXY_INSTALL_PATH=/opt/easysync/
EASYSYNC_PROXY_CONFIG_PATH=/opt/easysync/proxy/config.yaml
EASYSYNC_PROXY_LOG_PATH=/var/log/easysync/proxy.log
EASYSYNC_PROXY_BACKUP_PATH=/opt/easysync/backups

# 通知配置
EMAIL_SERVER=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_USE_TLS=True
EMAIL_FROM=your-email@example.com

# 调度器配置
SCHEDULER_API_ENABLED=True
SCHEDULER_TIMEZONE=Asia/Shanghai
MAX_INSTANCES=1
COALESCE=True
MAX_RETRIES=3
RETRY_DELAY=300  # 5 minutes in seconds

# 监控配置
MONITOR_INTERVAL=60
MONITOR_ENABLED=True
TASK_TIMEOUT=86400  # 24 hours in seconds

# 安全配置
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRES=86400  # 24 hours in seconds

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/var/log/easysync/app.log

# 性能配置
MAX_WORKERS=4
CHUNK_SIZE=1048576  # 1MB
BANDWIDTH_LIMIT=1048576  # 1MB/s

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# 安全配置
CORS_ORIGINS=*
CORS_ALLOWED_ORIGINS=http://your-frontend-domain.com